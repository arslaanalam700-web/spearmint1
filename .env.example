# AI Competitor Watch Agent - Environment Variables Template
# Copy this file to .env to configure local secrets.
# NEVER commit your actual .env file or API keys to GitHub.

# Optional: Google Gemini API Key for enhanced strategic reasoning & synthesis
# If left blank, the application will operate deterministically using the built-in rule & NLP engine.
GEMINI_API_KEY=

# Optional: OpenAI API Key (if using OpenAI models for synthesis)
OPENAI_API_KEY=

# Optional: Search API Keys (if using direct search services in addition to RSS & Hacker News)
TAVILY_API_KEY=
NEWS_API_KEY=

# Application Environment (development, production)
APP_ENV=development
